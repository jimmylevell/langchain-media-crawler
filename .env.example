# Azure OpenAI (Azure Portal → your OpenAI / AI Foundry resource → Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-name, e.g. gpt-4.1>
# Leave empty to use Entra ID instead (az login)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Optional fallback when AZURE_OPENAI_DEPLOYMENT is unset
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Foundry hosted agent deployment (deploy_foundry.py), Foundry portal → project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_HOSTED_AGENT_NAME=akquise-scanner

# Optional
# Send traces to Application Insights (injected in a Foundry hosted agent)
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional fallback spelling for the telemetry connection string
APPLICATION_INSIGHTS_CONNECTION_STRING=
# Self-hosted search server, e.g. http://localhost:8080; empty disables web search
SEARXNG_URL=
# Lower this if the deployment returns 429s
MAX_PARALLEL_AGENTS=4
# History, task statistics, reports, cache
DATA_DIR=data
# Requests per server and hour on the collected canton/municipality sites
SERVER_BUDGET_PER_HOUR=20
# Empty uses the cache subdirectory of DATA_DIR
SCANNER_CACHE_DIR=
# CHF; register liquidations below this capital are not reported
SHAB_MIN_KAPITAL=100000
SCANNER_USER_AGENT="AkquiseScanner/0.1 (regional media scan)"
