# Azure OpenAI (Azure Portal → your OpenAI / AI Foundry resource → Keys and Endpoint)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<deployment-name, e.g. gpt-4.1>
# Leave empty to use Entra ID instead (az login locally / managed identity on App Service)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Foundry hosted agent deployment (deploy_foundry.py), Foundry portal → project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Optional
# SEARXNG_URL=http://localhost:8080     # self-hosted search instead of DuckDuckGo
# MAX_PARALLEL_AGENTS=4                 # lower this if the deployment returns 429s
# DATA_DIR=/home/data                   # on Azure App Service (persistent storage)
# SERVER_BUDGET_PER_HOUR=20              # requests per server and hour on the collected canton/municipality sites
# SCANNER_CACHE_DIR=data/cache           # where collected lists and the request ledger are kept
